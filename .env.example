# ============================================================================
# DigitalVault Environment Variables (.env.example)
# Copy to .env and supply real credentials before running in production.
# NEVER commit real secrets or expose RAZORPAY_KEY_SECRET in frontend code!
# ============================================================================

# --- Branding & App URLs ---
APP_BRAND_NAME=DigitalVault
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api
VITE_RAZORPAY_PUBLIC_KEY_ID=rzp_test_YourPublicKeyIdHere

# --- Database Configuration (Choose 'mysql' or 'postgres') ---
SPRING_PROFILES_ACTIVE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=digitalvault
DB_USER=digitalvault_user
DB_PASSWORD=ReplaceWithStrongDatabasePassword

# --- JWT Security (Server-Only) ---
JWT_SECRET=ReplaceWith64ByteHighEntropyBase64SecretKeyForProductionUseOnly2026!!
JWT_EXPIRATION_MS=86400000

# --- Private File Storage & Signed URLs (Server-Only) ---
PRIVATE_VAULT_DIR=/var/digitalvault/private-assets
SIGNED_URL_SECRET=ReplaceWithSignedUrlHmacSecretKey2026!!

# --- Razorpay Payment Gateway (Server-Only Secret) ---
RAZORPAY_KEY_ID=rzp_test_YourPublicKeyIdHere
RAZORPAY_KEY_SECRET=ReplaceWithYourRazorpayKeySecret_ServerOnly
RAZORPAY_WEBHOOK_SECRET=ReplaceWithYourRazorpayWebhookSecret

# --- Google Drive API v3 Integration (Server-Only) ---
GOOGLE_DRIVE_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=/etc/digitalvault/gcp-service-account.json

# --- Email Notifications (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=notifications@digitalvault.in
SMTP_PASSWORD=ReplaceWithSmtpAppPassword
